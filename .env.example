# DigitallyDefined Marketing Site — Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local

# Supabase project URL
VITE_SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co

# Supabase anon key — REQUIRED for Hermes AI Mentor to work
VITE_SUPABASE_ANON_KEY=

# Shared API key (MUST match DASHBOARD_API_KEY in the os-backend/Supabase secrets)
# Set this to the SAME <shared_key> value that is provisioned as the Supabase
# secret DASHBOARD_API_KEY. If they differ, every Hermes call returns 401.
VITE_DASHBOARD_API_KEY=<shared_key>

# Override Hermes endpoint (optional — auto-derived from VITE_SUPABASE_URL if omitted)
# VITE_HERMES_ENDPOINT=

# Backend `/api` base URL. Used by the FastAPI microservice proxy
# (fastapi.* actions). Defaults to the production Vercel backend if omitted.
VITE_DASHBOARD_API_URL=https://digitallydefined-os-backend.vercel.app/api

# Override Hermes action (optional)
# VITE_HERMES_ACTION=

# Assistant model override ("auto" = let OmniRoute choose)
VITE_DASHBOARD_ASSISTANT_MODEL=auto

# NOTE: All AI traffic flows through the Hermes edge function → OmniRoute.
# Do NOT add direct provider keys here (OpenAI/Groq/Anthropic/etc. are not used).
