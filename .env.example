# DigitallyDefined Marketing Site — Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local

# Backend gateway base URL (all agents/tools call POST <base>/<endpoint>)
# Endpoints: /niche /roadmap /scorecard /product /social /trends /chat /dashboard
VITE_BACKEND_URL=https://digitallydefined-backend-clean.vercel.app/api

# Supabase project URL
VITE_SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co

# Supabase anon key — REQUIRED for the Hermes AI Mentor widget
VITE_SUPABASE_ANON_KEY=

# Shared API key — MUST match DASHBOARD_API_KEY on the backend.
# Sent as the x-api-key header on every backend call. If these differ,
# every agent/tool call returns 401.
VITE_DASHBOARD_API_KEY=<shared_key>

# Override the Hermes edge endpoint (optional — auto-derived from VITE_SUPABASE_URL)
# VITE_HERMES_ENDPOINT=

# Override the Hermes action (optional)
# VITE_HERMES_ACTION=

# NOTE: All AI traffic is routed server-side by the backend to Vertex AI Gemini
# (primary) with OpenRouter / Agnes as optional fallbacks. Do NOT add provider
# keys here — the browser never talks to an AI provider directly.
